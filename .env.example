# Optional. `npm start` loads .env automatically; Docker Compose reads it for substitutions.

# Docker Compose only: the host address and port where the RemoteHub container is published.
# Defaults are loopback-only at http://127.0.0.1:8090.
# Never publish 0.0.0.0 for direct HTTP access. Use a non-loopback bind only behind a
# TLS-terminating reverse proxy, firewall this port so only that proxy can reach it, and
# set SESSION_COOKIE_SECURE=true in .env.
REMOTEHUB_BIND_ADDRESS=127.0.0.1
REMOTEHUB_PORT=8090

# Interface to bind. 127.0.0.1 = only this machine (or a proxy on this machine).
# Use 0.0.0.0 if your reverse proxy runs on a different machine.
HOST=127.0.0.1
PORT=8090

# Where the owner account, saved hosts, and known fingerprints are stored.
DATA_DIR=./data

# Which proxy addresses may set X-Forwarded-* headers (Express "trust proxy" syntax).
# Default "loopback" fits a proxy on this machine. For a proxy elsewhere, use its IP, e.g. 192.168.1.10
TRUST_PROXY=loopback

# Extra origins allowed to use the app, comma-separated. Normally not needed:
# requests are accepted when Origin matches the Host / X-Forwarded-Host the proxy sends.
ALLOWED_ORIGINS=

# How long a login stays valid while idle (sliding), in hours.
SESSION_TTL_HOURS=12

# Maximum simultaneous terminal connections.
MAX_TERMINALS=16

# Maximum simultaneous file (SFTP) sessions.
MAX_FILES=16

# Maximum simultaneous persistent-agent control connections.
MAX_AGENTS=32

# Desktop for direct `npm start` (Compose configures its guacd service automatically).
# See deploy/guacd.md.
# GUACD_ENABLED=1
# GUACD_HOST=127.0.0.1
# GUACD_PORT=4822
# GUACD_HEALTH_PROTOCOL=rdp
# Public HTTPS origin used for OAuth metadata and the MCP resource URI.
# Required for remote OAuth deployments; example: https://remotehub.example.com
MCP_PUBLIC_URL=

# Exact browser Origin values allowed to call the remote MCP endpoint; comma-separated.
# Requests without Origin (server-to-server MCP clients) are accepted.
MCP_ALLOWED_ORIGINS=
# Optional host command execution; consent requires the separate commands:exec scope.
# Only Windows agents with Job Object cleanup advertise exec.run; the default is off.
# Commands run as the agent OS account; the filesystem root is only a working directory, not a sandbox.
MCP_COMMANDS_ENABLED=false

# Folder holding the agent builds RemoteHub installs on a target computer
# ("Install agent on this computer"). Each file is named remotehub-agent-<os>-<arch>,
# for example remotehub-agent-linux-x86_64 or remotehub-agent-macos-aarch64.
# Build them with: npm run build-agent
# Leave unset to disable the one-click install; the owner can still create an agent key
# by hand and run the agent themselves.
HELPER_DIR=
